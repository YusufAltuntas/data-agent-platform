# Anthropic API key (only used for runs against the real model)
ANTHROPIC_API_KEY=

# Optional Langfuse Cloud tracing; leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Host port Traefik is published on (80, or 8080 if 80 is taken)
PUBLIC_PORT=

# Keycloak seed user passwords
DAP_ALICE_PASSWORD=
DAP_BOB_PASSWORD=
DAP_CAROL_PASSWORD=
DAP_ADMIN_PASSWORD=

# Infrastructure passwords and keys
POSTGRES_PASSWORD=
DS_SALES_RO_PASSWORD=
DS_HR_RO_PASSWORD=
RABBITMQ_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
LITELLM_MASTER_KEY=
DAP_FERNET_KEY=
